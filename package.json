{
  "name": "andexor-net-website",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "sitemap": "bun scripts/generate-sitemap.ts",
    "build": "next build && bun scripts/copy-crawler-files.ts && bun scripts/format-site.ts",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "undeploy": "wrangler delete",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@awesome.me/kit-0a6c11d394": "^1.0.23",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@higgsfield/cli": "^1.2.2",
    "gray-matter": "^4.0.3",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "skills": "^1.7.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^25.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "trustedDependencies": [
    "@higgsfield/cli",
    "unrs-resolver",
    "workerd"
  ],
  "overrides": {
    "sharp": "file:./stubs/sharp"
  }
}
